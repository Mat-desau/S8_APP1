clc
clear all
close all

% Import des sons
[Sig1, Fe] = audioread('eagles_48k.wav');

%Information
N = length(Sig1);
L = 1024; %Dit dans la question
N_trames = N/(L - 1);
w = hanning(L);

m = 10;

premiere_trame = 50;
derniere_trame = 80;

ptr = (premiere_trame-1) * L + 1;

for trame = premiere_trame:derniere_trame
    x = sig1(ptr : ptr + L -1);
    xw = x .* w;
    a = lpc(xw, m);
    [H, w_axis] = freqz(1,a,L/2);
    H = H';
    w_axis = w_axis';
    Ha = 20*log10(abs(H));
    Xa = 20*log10(abs(fft(xw)));
    Xa = Xa(1:L/2);

    diff_max = 0;
    